{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Predict",
            "type": "debugpy",
            "request": "launch",
            "program": "predict.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Predict (all)",
            "type": "debugpy",
            "request": "launch",
            "program": "predict.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "--all",
                "--gpx", "data",
                "--power", "200",
                "--cyclist", "90",
            ]
        },
        {
            "name": "Predict (power km)",
            "type": "debugpy",
            "request": "launch",
            "program": "predict.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "power",
                "--gpx", "sortie.gpx",
                "--group-distance", "1000",
                "--cyclist", "90",
            ]
        },
        {
            "name": "Predict (power)",
            "type": "debugpy",
            "request": "launch",
            "program": "predict.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "power",
                "--gpx", "data/12aug26s.gpx",
                "--cyclist", "90",
            ]
        },
        {
            "name": "Predict (speed)",
            "type": "debugpy",
            "request": "launch",
            "program": "predict.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "speed",
                "--gpx", "data/22aug26.gpx",
                "--cyclist", "90",
                "--power", "185",
            ]
        },
    ]
}